{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "minebombers-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    "ALLOWED_ORIGIN": "http://localhost:5173"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
